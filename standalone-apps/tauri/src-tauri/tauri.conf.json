{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "niimblues",
  "version": "1.0.0",
  "identifier": "ru.mmote.niimblues",
  "build": {
    "frontendDist": "../www",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NiimBlues",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
