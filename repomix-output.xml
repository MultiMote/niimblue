<script lang="ts">
  import { onMount } from "svelte";
  import MainPage from "$/components/MainPage.svelte";
  import { registerPlugin, Capacitor } from "@capacitor/core";

  const PdfIntent = registerPlugin('PdfIntent');

  let pdfImageSrc: string | null = null;
  let debugError: string | null = null;

  onMount(async () => {
    if (Capacitor.getPlatform() === 'android') {
      
      // 1. Listen for PDFs if the app is already open in the background
      PdfIntent.addListener('onPdfReceived', (info: any) => {
        if (info && info.image) {
          pdfImageSrc = info.image;
        }
      });

      // 2. Explicitly ask Java: "Did a PDF launch this app?"
      try {
        const result = await PdfIntent.checkIntent();
        if (result && result.image) {
          pdfImageSrc = result.image;
        }
      } catch (e: any) {
        debugError = e.message || String(e);
        console.error("PDF Intent Error:", e);
      }
    }
  });
</script>

<MainPage />

<!-- Display the PDF if successful -->
{#if pdfImageSrc}
  <div style="position: absolute; top: 50px; left: 50px; right: 50px; z-index: 9999; background: white; padding: 20px; border: 4px solid green; box-shadow: 0 0 20px rgba(0,0,0,0.5);">
    <h3 style="color: black; margin-top: 0;">Success! PDF Received:</h3>
    <img src={pdfImageSrc} alt="PDF converted to image" style="width: 100%; border: 1px solid #ccc; margin-bottom: 15px;" />
    <div style="display: flex; gap: 10px;">
      <button style="padding: 10px; background: red; color: white; border: none; flex: 1;" onclick={() => pdfImageSrc = null}>
        Close
      </button>
    </div>
  </div>
{/if}

<!-- Display the ERROR if it failed -->
{#if debugError}
  <div style="position: absolute; top: 50px; left: 50px; right: 50px; z-index: 9999; background: white; padding: 20px; border: 4px solid red; box-shadow: 0 0 20px rgba(0,0,0,0.5);">
    <h3 style="color: red; margin-top: 0;">PDF Import Failed:</h3>
    <p style="color: black; word-wrap: break-word;">{debugError}</p>
    <button style="padding: 10px; background: black; color: white; border: none; width: 100%;" onclick={() => debugError = null}>
      Close
    </button>
  </div>
{/if}
