      <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="enabled" bind:checked={enabled} />
        <label class="form-check-label" for="enabled">{$tr("params.csv.enabled")}</label>
      </div>

      <div class="mt-3">
        {$tr("params.csv.tip")}
